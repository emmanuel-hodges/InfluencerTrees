# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# account IDs stay out of the repo.

aws_profile       = "iad-tf-prod"
account_id        = "000000000000"
github_repo       = "emmanuel-hodges/InfluencerTrees"
state_bucket_name = "inftrees-tfstate-prod-000000000000"

# Production accepts exactly one branch. Do not widen this.
allowed_subjects = ["ref:refs/heads/main"]
