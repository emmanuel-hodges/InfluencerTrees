// CloudFront Function (viewer-request). Rendered by Terraform; do not edit the
// deployed copy. Maps the hostname to a folder in the site bucket:
//
//   ${domain_name}/about        -> /${default_prefix}/about
//   pr-12.${domain_name}/about  -> /pr-12/about
//
// Runs before the cache lookup, so the rewritten path is the cache key and
// folders never share cached objects. S3 has no directory index behind an
// origin access control, so a trailing slash also gets index.html appended.
function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value : "";
  var prefix = "${default_prefix}";

  if (host !== "${domain_name}") {
    var label = host.split(".")[0];
    if (label) {
      prefix = label;
    }
  }

  var uri = request.uri;
  if (uri.endsWith("/")) {
    uri += "index.html";
  }

  request.uri = "/" + prefix + uri;
  return request;
}
