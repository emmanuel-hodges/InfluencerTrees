# Copy to api/.env.local (gitignored). Nothing here is a secret.

# memory: everything in-process, lost on restart; no AWS needed.
# dynamodb: the inftrees-app-dev table in the beta account over your SSO
# session (aws sso login --profile iad-tf-beta), shared by Mac and Codespaces.
STORE=memory
TABLE_NAME=inftrees-app-dev
AWS_PROFILE=iad-tf-beta
AWS_REGION=us-east-1
# Uncomment for DynamoDB Local if you ever run it: DYNAMODB_ENDPOINT=http://localhost:8000

# log: codes and invitations print in this terminal; ses: send for real
# (beta is in the SES sandbox, so only verified addresses receive anything).
EMAIL_MODE=log
# Also return the code in the request-code response, so curl can sign in.
DEV_RETURN_CODE=1

# The address that becomes the founding influencer on its first code request.
FOUNDER_EMAIL=you@example.com
# An address a person reads: the reply-to of every message and what the
# public About and Contact pages show. Defaults to FOUNDER_EMAIL.
# CONTACT_EMAIL=people@example.com

STAGE=local
PUBLIC_BASE_URL=http://localhost:5173
# Extra browser origins allowed to call the API, e.g. a Codespaces forward.
ALLOWED_ORIGINS=.app.github.dev
COOKIE_SECURE=false
